# Generated by Nginx's envsubst: only ${DOMAIN} and ${NGINX_CLIENT_MAX_BODY_SIZE}
# are substituted; Nginx's own $variables are left untouched.

limit_req_zone $binary_remote_addr zone=hub_login:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=hub_api:10m rate=20r/s;
limit_req_zone $binary_remote_addr zone=hub_upload:10m rate=10r/m;

upstream hub_app {
    server app:3000;
    keepalive 16;
}

server {
    listen 80;
    server_name ${DOMAIN};
    server_tokens off;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:HubSSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    # HSTS only over HTTPS. Add "; preload" once you are sure every subdomain is HTTPS.
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;

    server_tokens off;
    client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};

    # SECURITY: overwrite (never append) client-supplied forwarding headers.
    # The app trusts X-Real-IP for rate limiting, so it must come from here.
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $host;
    proxy_set_header Connection        "";
    proxy_http_version 1.1;

    # Brute-force protection in front of the app's own limiter.
    location = /api/auth/login {
        limit_req zone=hub_login burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://hub_app;
    }
    location /api/authjs/ {
        limit_req zone=hub_login burst=10 nodelay;
        limit_req_status 429;
        proxy_pass http://hub_app;
    }

    # Uploads and re-uploads: rate-limited, streamed straight to the app
    # (no temp-file buffering) with generous timeouts for slow connections.
    location ~ ^/api/admin/materials/(upload|[A-Za-z0-9_-]+/file)$ {
        limit_req zone=hub_upload burst=10 nodelay;
        limit_req_status 429;
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        proxy_pass http://hub_app;
    }

    location /api/ {
        limit_req zone=hub_api burst=40 nodelay;
        limit_req_status 429;
        proxy_pass http://hub_app;
    }

    location / {
        proxy_pass http://hub_app;
    }
}
