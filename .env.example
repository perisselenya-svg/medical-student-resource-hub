# =============================================================================
# Medical Student Resource Hub — configuration
#   cp .env.example .env && chmod 600 .env
# Fill in every value marked REQUIRED. Never commit .env.
# Generate secrets with:  openssl rand -base64 48   (or -hex 24 for passwords)
# Nothing in this file is ever sent to the browser.
# =============================================================================

# --- Public URL ---------------------------------------------------------------
# REQUIRED. Exact public origin, no trailing slash. Drives CSRF origin checks,
# Secure cookies (https => Secure + "__Secure-" prefixed session cookie),
# canonical URLs, Open Graph tags and the sitemap.
#   Local: http://localhost:3000      Production: https://resourcehub.example.org
APP_URL="http://localhost:3000"

# REQUIRED for Docker/Nginx: the hostname Nginx serves and Certbot certifies
# (same host as APP_URL).
DOMAIN="localhost"

# Email for Let's Encrypt expiry notices (used by the Certbot command).
CERTBOT_EMAIL="you@example.org"

# --- Authentication -----------------------------------------------------------
# REQUIRED. 32+ random characters. Encrypts and signs the admin session cookie.
# Rotating it signs every admin out.   openssl rand -base64 48
AUTH_SECRET=""

# Admin session lifetime in hours (default 8).
SESSION_MAX_AGE_HOURS=8

# Failed sign-ins allowed per (email + IP) per window before HTTP 429.
# Each IP is additionally limited to 4x this across all emails.
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# --- PostgreSQL ---------------------------------------------------------------
# REQUIRED for Docker. docker-compose builds the app's DATABASE_URL from these.
# Use a long random password without URL-special characters:  openssl rand -hex 24
POSTGRES_USER="resource_hub"
POSTGRES_PASSWORD=""
POSTGRES_DB="resource_hub"

# REQUIRED for local (non-Docker) development and for npm scripts run on the
# host. Ignored by docker-compose (it builds its own from POSTGRES_*).
DATABASE_URL="postgresql://resource_hub:CHANGE_ME@localhost:5432/resource_hub?schema=public"

# --- File storage -------------------------------------------------------------
# Only "local" ships in v1 (see src/lib/files/storage for the S3/MinIO hook).
STORAGE_DRIVER="local"

# Where uploads are stored. MUST be outside public/ — files are only served
# through the access-controlled /api/files/:id route. Docker always uses
# /data/uploads on the persistent "uploads" volume.
UPLOAD_DIR="./uploads"

# Maximum size per uploaded file in MB (1–1024). Default 25.
MAX_UPLOAD_SIZE_MB=25

# Nginx request-body cap: keep a few MB ABOVE MAX_UPLOAD_SIZE_MB so the app
# (not Nginx) returns the friendly "file too large" error.
NGINX_CLIENT_MAX_BODY_SIZE="30m"

# Uploads/re-uploads allowed per admin per window (Nginx adds 10/min per IP).
UPLOAD_RATE_LIMIT_MAX=30
UPLOAD_RATE_LIMIT_WINDOW_MINUTES=10

# --- Seed (npm run db:seed) ------------------------------------------------------
# The ONE admin account created by the seed. Password: 12–72 chars with upper
# case, lower case and a digit. Remove SEED_ADMIN_PASSWORD after seeding.
SEED_ADMIN_EMAIL="admin@example.org"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Site Administrator"

# true = also add sample materials and a sample quiz to an EMPTY library
# (handy for local development; keep false in production).
SEED_DEMO_CONTENT=false
