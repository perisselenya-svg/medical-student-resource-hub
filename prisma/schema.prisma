// Medical Student Resource Hub — database schema (PostgreSQL).
// After editing: `npm run db:migrate -- --name <change>` (dev) / `npm run db:deploy` (production).

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// Only administrators have accounts. Students never register or log in (v1).
enum Role {
  ADMIN
}

/// Broad file category used for filtering and choosing a viewer.
enum FileType {
  PDF
  IMAGE
  MARKDOWN
}

enum AuditAction {
  LOGIN_SUCCESS
  LOGIN_FAILURE
  LOGOUT
  MATERIAL_CREATE
  MATERIAL_UPDATE
  MATERIAL_REPLACE_FILE
  MATERIAL_DELETE
  CATEGORY_CREATE
  CATEGORY_UPDATE
  CATEGORY_DELETE
  TAG_CREATE
  TAG_UPDATE
  TAG_DELETE
  QUIZ_CREATE
  QUIZ_UPDATE
  QUIZ_DELETE
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  /// bcrypt hash (cost 12). Plain-text passwords are never stored or logged.
  passwordHash String
  name         String?
  role         Role      @default(ADMIN)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  materials Material[]
  auditLogs AuditLog[]

  @@map("users")
}

model Category {
  id           String   @id @default(cuid())
  name         String   @unique
  slug         String   @unique
  description  String?
  /// Lower numbers appear first in navigation and on the Subjects page.
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  materials Material[]
  quizzes   Quiz[]

  @@index([displayOrder, name])
  @@map("categories")
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  materials MaterialTag[]

  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "tags_name_trgm_idx")
  @@map("tags")
}

model Material {
  /// UUID generated by the application before insert so fileUrl can embed it.
  id               String   @id @default(uuid())
  title            String
  slug             String   @unique
  description      String   @default("")
  /// Public, access-controlled URL: /api/files/<id>. Never a direct disk path.
  fileUrl          String   @unique
  /// Storage key relative to UPLOAD_DIR, e.g. "2026/10/<uuid>.pdf".
  /// Server-generated, never derived from user input, never exposed to clients.
  storedFileName   String   @unique
  /// Original name as uploaded, kept for display and download filenames only.
  originalFileName String
  fileType         FileType
  /// MIME type detected from the file's signature at upload (not client-supplied).
  mimeType         String
  /// Size in bytes.
  fileSize         Int
  isPublished      Boolean  @default(false)
  isFeatured       Boolean  @default(false)
  viewCount        Int      @default(0)
  downloadCount    Int      @default(0)
  /// First time the material was published (drives "latest" ordering).
  publishedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  categoryId   String
  category     Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  uploadedById String?
  uploadedBy   User?         @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  tags         MaterialTag[]

  @@index([isPublished, createdAt])
  @@index([isPublished, viewCount])
  @@index([isPublished, downloadCount])
  @@index([isPublished, isFeatured])
  @@index([categoryId])
  @@index([fileType])
  // Trigram indexes accelerate case-insensitive substring search (ILIKE '%term%').
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "materials_title_trgm_idx")
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, map: "materials_description_trgm_idx")
  @@map("materials")
}

model MaterialTag {
  materialId String
  tagId      String

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([materialId, tagId])
  @@index([tagId])
  @@map("material_tags")
}

model Quiz {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String   @default("")
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions Question[]

  @@index([isPublished, createdAt])
  @@index([categoryId])
  @@map("quizzes")
}

model Question {
  id           String   @id @default(cuid())
  quizId       String
  quiz         Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionText String
  /// Shown to the student after they answer.
  explanation  String   @default("")
  order        Int
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  options AnswerOption[]

  @@index([quizId, order])
  @@map("questions")
}

model AnswerOption {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  optionText String
  /// Never sent to students before they submit an answer.
  isCorrect  Boolean  @default(false)
  order      Int

  @@index([questionId, order])
  @@map("answer_options")
}

model AuditLog {
  id         String      @id @default(cuid())
  /// Nullable so failed logins (no authenticated admin) can be recorded and
  /// history survives if an admin account is removed.
  adminId    String?
  admin      User?       @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action     AuditAction
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime    @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([adminId])
  @@map("audit_logs")
}
